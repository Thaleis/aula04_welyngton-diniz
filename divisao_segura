divisao = 0
print("Digite um número:")
while True:
    try:
        num1 = float(input("- "))
        break
    except ValueError:
        print("Digite um número!")
print("Digite outro número:")
while True:
    try:
        num2 = float(input("- "))
        break
    except ValueError:
        print("Digite um número!!")
    
try:
    divisao = num1 / num2
    print(f"{num1} dividido por {num2} é igual a {divisao:.2f}")
except ZeroDivisionError:
        print("Impossivel dividir por 0!")
finally:
    print("Operação finalizada.")
